# Every source the engines are built from, pinned to a tag and checked
# against the commit that tag named when it was chosen. The CI caches are
# keyed on this file, so changing a version rebuilds what depends on it.

# The Mac app ships ffmpeg 6.0, and the renderer is written around its quirks.
FFMPEG_REPO=https://github.com/FFmpeg/FFmpeg
FFMPEG_TAG=n6.0
FFMPEG_COMMIT=ea3d24bbe3c58b171e55fe2151fc7ffaca3ab3d2

FREETYPE_REPO=https://github.com/freetype/freetype
FREETYPE_TAG=VER-2-14-3
FREETYPE_COMMIT=0a0221a1347e2f1e07c395263540026e9a0aa7c7

FRIBIDI_REPO=https://github.com/fribidi/fribidi
FRIBIDI_TAG=v1.0.16
FRIBIDI_COMMIT=68162babff4f39c4e2dc164a5e825af93bda9983

HARFBUZZ_REPO=https://github.com/harfbuzz/harfbuzz
HARFBUZZ_TAG=11.5.1
HARFBUZZ_COMMIT=7497c4147469fd4102a7229222586ad5c743c5a1

LIBASS_REPO=https://github.com/libass/libass
LIBASS_TAG=0.17.4
LIBASS_COMMIT=bbb3c7f1570a4a021e52683f3fbdf74fe492ae84

ZIMG_REPO=https://github.com/sekrit-twc/zimg
ZIMG_TAG=release-3.0.6
ZIMG_COMMIT=f819b14e8f39d1282400b0d9543e8ef73c1b2bbd

LIBWEBP_REPO=https://github.com/webmproject/libwebp
LIBWEBP_TAG=v1.5.0
LIBWEBP_COMMIT=a4d7a715337ded4451fec90ff8ce79728e04126c

DAV1D_REPO=https://github.com/videolan/dav1d
DAV1D_TAG=1.5.3
DAV1D_COMMIT=b546257f770768b2c88258c533da38b91a06f737

# Opus for sound sent to the AI services: about a third the size of FLAC.
OPUS_REPO=https://github.com/xiph/opus
OPUS_TAG=v1.6.1
OPUS_COMMIT=22244de5a79bd1d6d623c32e72bf1954b56235be

# The same whisper.cpp the Mac app builds (scripts/build-whisper.sh), so the
# flags in src/main/whisper-args.ts mean the same thing on the phone.
WHISPER_REPO=https://github.com/ggml-org/whisper.cpp
WHISPER_TAG=v1.8.2
WHISPER_COMMIT=4979e04f5dcaccb36057e059bbaed8a2f5288315

# Capacitor 8's floor on each platform.
ANDROID_API=24
IOS_MIN=15.0
