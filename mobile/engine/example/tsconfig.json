{
  // Type-checks the self-test with the desktop code it imports from
  // src/main; that code's own types (zod, node) come from the repository's
  // npm install. esbuild (build.mjs) bundles without type-checking.
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    // The plugin's types import @capacitor/core from outside this folder.
    "paths": {
      "@capacitor/core": ["./node_modules/@capacitor/core"]
    }
  },
  "include": ["src"]
}
