{
  "name": "cutalong-mobile",
  "version": "0.2.13",
  "private": true,
  "description": "Cutalong on iPhone and Android: the same app and the same work as on the Mac, with ffmpeg and whisper.cpp inside it.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "bridge": "node dev/engine-bridge.mjs",
    "sync": "npm run build && cap sync"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/file-transfer": "2.0.6",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/preferences": "8.0.1",
    "capacitor-secure-storage-plugin": "0.13.0",
    "cutalong-engine": "file:./engine"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "5.4.21"
  }
}
