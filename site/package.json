{
  "name": "cutalong-site",
  "version": "1.0.0",
  "private": true,
  "description": "The Cutalong marketing site: static HTML, CSS and JavaScript built with no dependencies, and one Pages Function for the email list.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview": "node scripts/build.mjs --preview --out .preview",
    "serve": "node scripts/build.mjs && node scripts/serve.mjs",
    "check": "node scripts/check.mjs",
    "images": "node scripts/images.mjs",
    "shapes": "node scripts/shapes.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:e2e": "node tests/signup.e2e.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
